# SmartLearn Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

NODE_ENV=development
PORT=4000

# MongoDB Connection String (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/smartlearn?retryWrites=true&w=majority)
MONGO_URI=

# JWT Secret for signing authentication tokens (use a strong random string)
JWT_SECRET=

# Frontend Application URL (for CORS and Socket.IO origin - comma-separated for multiple origins)
FRONTEND_URL=https://smartlearnproject-virid.vercel.app,http://localhost:3000

# Nodemailer / Email Service Credentials for OTP Delivery
EMAIL_USER=
EMAIL_PASS=

# Cloudinary Storage Credentials for Assignment & File Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API Key for AI Tutor & Daily Challenge Generation
GEMINI_API_KEY=
GEMINI_API_KEY2=
